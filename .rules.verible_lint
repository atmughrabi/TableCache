# verible-verilog-lint config for TableCache.
#
# This fork inherits an upstream style that predates verible. Rather
# than mass-refactor for stylistic conformance, we enable only the
# rules that catch genuine bugs (mismatched always block type, missing
# defaults, defparam, etc.) and disable all purely-stylistic rules.
#
# Use:
#   verible-verilog-lint --rules_config_search src/*.sv
#
# Or via the project make wrapper:
#   make -C tb/cocotb vlint   (added alongside `make lint`)

# ---- bug-catching rules: keep enabled ----
+always-comb
+always-comb-blocking
+always-ff-non-blocking
+case-missing-default
+forbid-defparam
+forbid-consecutive-null-statements
+disable-statement
+truncated-numeric-literal
-unpacked-dimensions-range-ordering

# ---- pure style / naming / formatting: disable (upstream convention) ----
-line-length
-explicit-parameter-storage-type
-parameter-name-style
-enum-name-style
-typedef-enums
-generate-label-prefix
-generate-label
-no-tabs
-no-trailing-spaces
-module-filename
-package-filename
-explicit-function-lifetime
-explicit-function-task-parameter-type
-explicit-task-lifetime
-create-object-name-match
-instance-shadowing
-macro-name-style
-signal-name-style
-undersized-binary-literal
-suggest-parentheses
-positive-meaning-parameter-name
-uvm-macro-semicolon
-numeric-format-string-style
