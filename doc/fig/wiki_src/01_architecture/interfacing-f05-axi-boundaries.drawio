  <diagram id="tablecache-axi-boundaries" name="AXI boundary contract" tablecacheTitle="AXI boundary contract" tablecacheDescription="A system master connects to the request-side AXI channels and ACE-style snoop sidebands. The cache connects its memory-side AXI channels to an error-free backend. Both interfaces share one synchronous clock and reset.">
