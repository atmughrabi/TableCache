<mxfile host="app.diagrams.net" agent="TableCache figure authoring" type="device" compressed="false">
  <diagram id="tablecache-request-memory-paths" name="TableCache request and memory paths" tablecacheTitle="TableCache request and memory paths" tablecacheDescription="AXI read and write addresses pass through input queues and tag lookup, while W data bypasses tag lookup and enters the databank from its FIFO. Hit data comes from the databank, while returned fill data feeds both the databank and ordered response logic through an optional victim cache. An invariant panel summarizes ID, ordering, and writeback rules.">
