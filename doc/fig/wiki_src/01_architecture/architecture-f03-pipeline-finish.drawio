        <mxCell id="header" value="" style="shape=rectangle;rounded=1;arcSize=8;html=0;fillColor=#F7F4E4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1560" height="145" as="geometry"/></mxCell>
